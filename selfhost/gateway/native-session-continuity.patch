+function latestModelRecoveryEvent(hostId: number, threadId: string, turnId: string, cursor: number) {
+  // 订阅游标会跳过已有事件。只带回活动轮次在该游标前仍有效的恢复通知，后续事件走原回放。
+  const latest = gatewayEventStore.list(hostId, threadId, 0, 500).findLast(({ id, event }) => {
+    if (id > cursor) return false;
+    switch (event.type) {
+      case "error.reported":
+        return event.params.turnId === turnId;
+      case "notice":
+        return (
+          event.source === "warning" &&
+          event.params.threadId === threadId &&
+          typeof event.params.message === "string" &&
+          event.params.message.startsWith("Falling back from WebSockets to HTTPS transport")
+        );
+      case "timeline.item.delta":
+        return event.turnId === turnId && event.channel !== "commandOutput" && event.delta.length > 0;
+      case "timeline.item.upsert":
+        return (
+          event.item.turnId === turnId &&
+          typeof event.item.type === "string" &&
+          event.item.type !== "userMessage" &&
+          (event.item.status === "inProgress" || event.item.type === "agentMessage")
+        );
+      case "turn.started":
+      case "turn.completed":
+        return true;
+      default:
+        return false;
+    }
+  });
+  return latest?.event.type === "notice" ||
+    (latest?.event.type === "error.reported" && latest.event.params.willRetry === true)
+    ? latest
+    : undefined;
+}
