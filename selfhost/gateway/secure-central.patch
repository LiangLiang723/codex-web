new file mode 100644
--- /dev/null
+++ b/server/utils/gateway/storage/thread-index.ts
@@ -0,0 +1,38 @@
+import { z } from "zod";
+import { decryptJson, encryptJson } from "./crypto";
+import { gatewayDatabase } from "./database";
+import type { ThreadMetadataRecord } from "../state/memory";
+
+const storedMetadata = z.object({
+  hostId: z.number().int(),
+  threadId: z.string(),
+  parentThreadId: z.string().nullable(),
+  agentNickname: z.string().nullable(),
+  agentRole: z.string().nullable(),
+  title: z.string().nullable(),
+  name: z.string().nullable(),
+  preview: z.string().nullable(),
+  cwd: z.string().nullable(),
+  recencyAt: z.number().nullable(),
+  updatedAt: z.number(),
+});
+// Keep only navigation metadata locally. Turns, item bodies and pending approvals belong to Codex.
+export function loadThreadIndex(userId: number | null): ThreadMetadataRecord[] {
+  if (userId === null) return [];
+  return gatewayDatabase()
+    .prepare("SELECT metadata FROM thread_index WHERE user_id = ?")
+    .all(userId)
+    .map((row) => ({
+      ...storedMetadata.parse(decryptJson(String(row.metadata))),
+      status: { type: "notLoaded" },
+    }));
+}
+
+export function persistThreadMetadata(userId: number | null, meta: ThreadMetadataRecord) {
+  if (userId === null) return;
+  gatewayDatabase()
+    .prepare(
+      "INSERT INTO thread_index(user_id,host_id,thread_id,metadata) VALUES (?,?,?,?) ON CONFLICT(user_id,host_id,thread_id) DO UPDATE SET metadata=excluded.metadata",
+    )
+    .run(userId, meta.hostId, meta.threadId, encryptJson(meta));
+}
