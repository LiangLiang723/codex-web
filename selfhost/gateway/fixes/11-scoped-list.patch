+async function readThreadListPage(
+  host: HostRecord,
+  params: Record<string, unknown> & { includedThreadIds?: string[]; archived?: boolean; cwd?: string },
+): Promise<ThreadListPage> {
+  const page = await threadBroker.listThreads(host, params);
+  if (!params.includedThreadIds) return page;
+  const selected = new Set(params.includedThreadIds);
+  if (!page.nextCursor && page.data.every(thread => selected.has(thread.id))) return page;
+
+  // 0.170 忽略原生 ID 筛选字段。按选定 ID 查元数据和 rollout 归档位置，避免继续扫描索引。
+  const threads = await Promise.all(params.includedThreadIds.map(id => readSelfhostThreadSummary(host, id)));
+  return {
+    data: threads.filter((thread): thread is AppServerThread => {
+      if (!thread || (params.cwd && thread.cwd !== params.cwd)) return false;
+      const archived = thread.path?.split(/[\\/]/u).at(-2) === "archived_sessions";
+      return archived === (params.archived === true);
+    }),
+    nextCursor: null,
+  };
+}
 
