diff --git a/shared/runtime/realtime/selfhost-delivery.ts b/shared/runtime/realtime/selfhost-delivery.ts
new file mode 100644
index 0000000..e8c2eac
--- /dev/null
+++ b/shared/runtime/realtime/selfhost-delivery.ts
@@ -0,0 +1,98 @@
+import { z } from "zod";
+import { uploadedFileSchema } from "../uploaded-file";
+import { nonEmptyString, positiveId, requestIdField, threadScopeFields } from "./common";
+
+export const trackedDeliveryFields = { deliveryId: z.uuid().optional() };
+const commandKey = z.object({ sessionId: nonEmptyString.nullable(), commandId: z.uuid() }).strict();
+const deliveryState = z.object({
+  state: z.enum(["creating", "created", "pending", "accepted", "rejected"]),
+  threadId: nonEmptyString.nullable(),
+  delivery: z.enum(["startNow", "guide", "queue"]).nullable(),
+  turnId: nonEmptyString.nullable(),
+});
+const queueItem = z.object({
+  id: nonEmptyString,
+  clientUserMessageId: nonEmptyString,
+  input: z.array(z.record(z.string(), z.unknown())),
+});
+
+export const selfhostDeliveryQuerySchema = z.object({
+  type: z.literal("thread.delivery.query"),
+  ...requestIdField,
+  hostId: positiveId,
+  cwd: z.string().startsWith("/"),
+  commands: z.array(commandKey).min(1).max(64),
+}).strict();
+export const selfhostControlsReadSchema = z.object({
+  type: z.literal("thread.native.controls"),
+  ...requestIdField,
+  ...threadScopeFields,
+}).strict();
+export const selfhostQueueAddSchema = z.object({
+  type: z.literal("thread.queue.add"),
+  ...requestIdField,
+  ...threadScopeFields,
+  deliveryId: z.uuid(),
+  text: z.string(),
+  files: z.array(uploadedFileSchema).optional(),
+  images: z.array(z.object({
+    path: z.string().optional(),
+    url: z.string().optional(),
+    detail: z.enum(["low", "high", "auto", "original"]).optional(),
+  }).strict()).optional(),
+}).strict();
+export const selfhostQueueDeleteSchema = z.object({
+  type: z.literal("thread.queue.delete"),
+  ...requestIdField,
+  ...threadScopeFields,
+  queuedSubmissionId: nonEmptyString,
+}).strict();
+export const selfhostCompactSchema = z.object({
+  type: z.literal("thread.native.compact"),
+  ...requestIdField,
+  ...threadScopeFields,
+}).strict();
+
+export const selfhostDeliveryStateSchema = deliveryState.extend({
+  type: z.literal("thread.delivery.state"),
+  ...requestIdField,
+  hostId: positiveId,
+}).strict();
+export const selfhostDeliveryResultsSchema = z.object({
+  type: z.literal("thread.delivery.results"),
+  ...requestIdField,
+  hostId: positiveId,
+  results: z.array(z.union([
+    deliveryState.extend({ key: commandKey }).strict(),
+    z.object({ key: commandKey, state: z.literal("missing") }).strict(),
+  ])),
+}).strict();
+export const selfhostControlsResultSchema = z.object({
+  type: z.literal("thread.native.controls.result"),
+  ...requestIdField,
+  ...threadScopeFields,
+  queue: z.boolean(),
+  fork: z.boolean(),
+  compact: z.boolean(),
+  queued: z.array(queueItem),
+}).strict();
+export const selfhostQueueDeletedSchema = z.object({
+  type: z.literal("thread.queue.deleted"),
+  ...requestIdField,
+  ...threadScopeFields,
+  deleted: z.boolean(),
+}).strict();
+export const selfhostCompactAcceptedSchema = z.object({
+  type: z.literal("thread.native.compact.accepted"),
+  ...requestIdField,
+  ...threadScopeFields,
+}).strict();
+
+export type SelfhostDeliveryClientMessage = z.infer<
+  typeof selfhostDeliveryQuerySchema | typeof selfhostControlsReadSchema |
+  typeof selfhostQueueAddSchema | typeof selfhostQueueDeleteSchema | typeof selfhostCompactSchema
+>;
+export type SelfhostDeliveryServerMessage = z.infer<
+  typeof selfhostDeliveryStateSchema | typeof selfhostDeliveryResultsSchema |
+  typeof selfhostControlsResultSchema | typeof selfhostQueueDeletedSchema | typeof selfhostCompactAcceptedSchema
+>;
