diff --git a/server/utils/gateway/runtime/thread-history-refresh.ts b/server/utils/gateway/runtime/thread-history-refresh.ts
new file mode 100644
--- /dev/null
+++ b/server/utils/gateway/runtime/thread-history-refresh.ts
@@ -0,0 +1,149 @@
+import type { AgentEvent } from "~~/shared/agent/events";
+import { SERVER_TURN_CACHE_LIMIT } from "~~/shared/config";
+import { applyCanonicalEventToHistory } from "~~/shared/thread-history/canonical-events";
+import { sameItem } from "~~/shared/thread-history/item-identity";
+import { mergeThreadItem, mergeTurnItems } from "~~/shared/thread-history/item-merge";
+import type {
+  ThreadHistoryItem,
+  ThreadHistoryState,
+  ThreadHistoryTurn,
+} from "~~/shared/thread-history/types";
+import { recordFromUnknown } from "~~/shared/utils/records";
+import { gatewayEventStore } from "../state/gateway-events";
+import { threadSnapshotStore } from "../state/thread-snapshots";
+import { applyEventToOpenSnapshot } from "./open-snapshot-events";
+import { threadRuntimeEvents } from "./thread-runtime-events";
+import type { ThreadOpenSnapshot } from "./types";
+
+export type ThreadHistoryRefresh = ReturnType<typeof captureThreadHistoryRefresh>;
+
+export function captureThreadHistoryRefresh(hostId: number, threadId: string) {
+  const epoch = gatewayEventStore.epoch(hostId);
+  const currentEpoch = () => epoch === gatewayEventStore.epoch(hostId);
+  const previous = threadSnapshotStore.get(hostId, threadId);
+  const touched = new Set<string>();
+  const metadata = new Map<string, AgentEvent>();
+  let coldHistory: ThreadHistoryState | null = null;
+  const reduceCold = (event: AgentEvent) => {
+    coldHistory = applyCanonicalEventToHistory(coldHistory, null, threadId, event);
+    if (coldHistory !== null && coldHistory.thread.turns.length > SERVER_TURN_CACHE_LIMIT) {
+      coldHistory.thread.turns = coldHistory.thread.turns.slice(-SERVER_TURN_CACHE_LIMIT);
+    }
+  };
+  if (previous === null) {
+    for (const { event } of gatewayEventStore.list(hostId, threadId, 0, 500)) reduceCold(event);
+  }
+  const dispose = threadRuntimeEvents.subscribe(hostId, threadId, ({ event }) => {
+    if (!currentEpoch()) return;
+    const turnId = eventTurnId(event);
+    if (turnId !== undefined) touched.add(turnId);
+    if (previous === null) reduceCold(event);
+    if (
+      event.type === "thread.settings.updated" ||
+      (event.type === "notice" && event.source === "thread/name/updated")
+    ) {
+      metadata.set(event.type, event);
+    }
+  });
+  return {
+    assertCurrent() {
+      if (!currentEpoch()) throw new Error("Codex history read was superseded by a host reconnect");
+    },
+    dispose,
+    merge(page: ThreadHistoryTurn[]) {
+      const live =
+        (previous === null
+          ? coldHistory
+          : (threadSnapshotStore.get(hostId, threadId) ?? previous).history
+        )?.thread.turns ?? [];
+      const liveTurns = new Map(
+        live
+          .filter((turn) => turn.status === "inProgress" || touched.has(String(turn.id)))
+          .map((turn) => [String(turn.id), turn]),
+      );
+      const turns = page.map((persisted) => {
+        const id = String(persisted.id);
+        const inFlight = liveTurns.get(id);
+        liveTurns.delete(id);
+        return inFlight === undefined ? persisted : mergeOpenTurn(persisted, inFlight);
+      });
+      return [...turns, ...liveTurns.values()];
+    },
+    applyMetadata(snapshot: ThreadOpenSnapshot) {
+      for (const event of metadata.values())
+        snapshot = applyEventToOpenSnapshot(snapshot, event) ?? snapshot;
+      return snapshot;
+    },
+  };
+}
+
+function eventTurnId(event: AgentEvent): string | undefined {
+  switch (event.type) {
+    case "turn.started":
+    case "turn.completed":
+      return event.turn.id == null ? undefined : String(event.turn.id);
+    case "timeline.item.upsert":
+    case "serverRequest.requested": {
+      const turnId = recordFromUnknown(event.item)?.turnId;
+      return typeof turnId === "string" ? turnId : undefined;
+    }
+    case "timeline.item.delta":
+    case "timeline.item.reasoningSummaryPartAdded":
+    case "turn.diff.updated":
+    case "turn.plan.updated":
+    case "turn.usage.upsert":
+      return String(event.turnId);
+    default:
+      return undefined;
+  }
+}
+
+function mergeOpenTurn(persisted: ThreadHistoryTurn, live: ThreadHistoryTurn): ThreadHistoryTurn {
+  const terminal = ["completed", "interrupted", "failed"].includes(String(persisted.status));
+  const source = terminal ? persisted : live;
+  return {
+    ...persisted,
+    ...source,
+    startedAt: source.startedAt ?? persisted.startedAt,
+    itemsView: persisted.itemsView === "full" ? "full" : (source.itemsView ?? persisted.itemsView),
+    items: mergeTurnItems(
+      persisted.items ?? [],
+      (live.items ?? []).map((item) => {
+        const stored = persisted.items?.find((candidate) => sameItem(candidate, item));
+        return stored === undefined ? item : mergeOpenItem(stored, item, terminal);
+      }),
+    ),
+  };
+}
+
+function mergeOpenItem(stored: ThreadHistoryItem, live: ThreadHistoryItem, terminal: boolean) {
+  const completed = terminal || stored.completedAtMs != null || stored.status === "completed";
+  if (completed || stored.type === "userMessage") return mergeThreadItem(live, stored);
+  if (live.completedAtMs != null || live.status === "completed")
+    return mergeThreadItem(stored, live);
+
+  // 同一个条目分别有原生页和实时累计两份状态。只选已知前缀的较新累计值，
+  // 避免把页中已经持久化的增量再次拼接。条目完成通知补齐尚无起点的旧流。
+  const merged = mergeThreadItem(live, stored);
+  return {
+    ...merged,
+    text: newerPrefix(stored.text, live.text),
+    aggregatedOutput: newerPrefix(stored.aggregatedOutput, live.aggregatedOutput),
+    summary: newerParts(stored.summary, live.summary),
+    ...(stored.type === "reasoning" ? { content: newerParts(stored.content, live.content) } : {}),
+  };
+}
+
+function newerPrefix<T>(stored: T, live: T): T {
+  return stored == null ||
+    (typeof live === "string" && typeof stored === "string" && live.startsWith(stored))
+    ? live
+    : stored;
+}
+
+function newerParts(stored: unknown[] | undefined, live: unknown[] | undefined) {
+  if (!stored || !live) return stored ?? live;
